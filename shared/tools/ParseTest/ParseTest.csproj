<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ParseTest —— 离线验证 BridgeLiftData 的手写解析器
    BridgeLiftData.cs 只依赖 System/IO，不碰任何游戏类型，所以可以直接拿出来单跑。
    Mod.cs 里那个 InstallFolder 用下面的 Stub.cs 顶掉（Resolve 里我们传显式路径）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ParseTest</AssemblyName>
    <RootNamespace>ParseTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stub.cs" />
    <Compile Include="..\..\mod\HarbinBridgeLift\BridgeLiftData.cs" />
  </ItemGroup>
</Project>
